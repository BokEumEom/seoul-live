# 목업 데이터로 실행할지 여부.
# 서울 열린데이터광장 인증키가 없으면 true로 둔다.
# sample 키는 지역명과 무관하게 항상 광화문·덕수궁만 돌려주므로 개발에 쓸 수 없다.
VITE_USE_MOCK=true

# HTTPS 중계 프록시 주소. VITE_USE_MOCK=false일 때만 필요하다.
# Vercel 배포 후 실제 도메인으로 채운다. 예: https://seoul-live-api.vercel.app
VITE_API_BASE_URL=

# (선택) 목업 모드에서 조회 실패를 흉내 낼 명소 이름, 쉼표로 구분.
# 예: VITE_MOCK_FAIL_AREAS=경복궁,강남역
# "정보 없음" 카드 상태를 인증키 없이 목업만으로 개발·테스트할 때 쓴다.
VITE_MOCK_FAIL_AREAS=

# Google Maps JavaScript API 키. 지도가 화면 전체의 배경이라 앱의 첫 화면부터 쓴다.
# 이 키는 클라이언트 번들에 들어간다 — 숨길 수 없는 게 정상이고 버그가 아니다.
# 지도 타일과 스크립트를 브라우저가 직접 받아야 해서 프록시 뒤로 옮길 수 없다.
# 보호는 은닉이 아니라 Google Cloud 콘솔의 제한으로 한다:
#   HTTP 리퍼러 — https://seoul-live.web.tossmini.com/*
#                 https://seoul-live.private-web.tossmini.com/*
#                 http://localhost:5173/*
#   API 제한   — Maps JavaScript API 하나만
# 비워두면 지도 자리에 "키 미설정" 안내가 뜨고 시트가 half에 묶인다. 목록·검색·
# 필터·명소 상세는 그대로 동작한다 — 지도가 없어도 앱은 선다.
VITE_GOOGLE_MAPS_API_KEY=

# 지도 스타일 ID. AdvancedMarker(혼잡도 마커)가 Map ID를 요구한다 — 없으면
# 마커가 아예 렌더되지 않는다. 개발 중에는 비워두면 DEMO_MAP_ID를 쓴다.
# 출시 전에는 Cloud Console에서 발급한 자체 Map ID로 반드시 교체한다.
VITE_GOOGLE_MAPS_MAP_ID=

# 아래 셋은 서버(Vercel Function) 전용이라 여기가 아니라
# Vercel 프로젝트 환경변수에 넣는다. 클라이언트 번들에 들어가면 안 된다.
#
#   SEOUL_API_KEY                서울 열린데이터광장 일반 인증키
#   CACHE_TTL_SECONDS            혼잡도(citydata_ppltn) CDN 캐시 TTL.
#                                활용갤러리 등록 전 3600, 후 300
#   CITYINFO_CACHE_TTL_SECONDS   명소 상세의 접이식 도시 정보(citydata) 전용 TTL.
#                                비우면 위 값으로 떨어진다. 이건 별도 호출이라 하루
#                                1,000회 한도를 혼잡도와 나눠 쓴다 — 늘리면 호출이
#                                줄고 주차 면수가 묵는다.
#                                근거는 AGENTS.md "하루 1,000회 호출 제한".
