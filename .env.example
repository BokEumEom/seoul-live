# 목업 데이터로 실행할지 여부.
# 서울 열린데이터광장 인증키가 없으면 true로 둔다.
# sample 키는 지역명과 무관하게 항상 광화문·덕수궁만 돌려주므로 개발에 쓸 수 없다.
VITE_USE_MOCK=true

# HTTPS 중계 프록시 주소. VITE_USE_MOCK=false일 때만 필요하다.
# Vercel 배포 후 실제 도메인으로 채운다. 예: https://seoul-live-api.vercel.app
VITE_API_BASE_URL=

# (선택) 목업 모드에서 조회 실패를 흉내 낼 명소 이름, 쉼표로 구분.
# 예: VITE_MOCK_FAIL_AREAS=경복궁,강남역
# "정보 없음" 카드 상태를 인증키 없이 목업만으로 개발·테스트할 때 쓴다.
VITE_MOCK_FAIL_AREAS=

# 아래 두 개는 서버(Vercel Function) 전용이라 여기가 아니라
# Vercel 프로젝트 환경변수에 넣는다. 클라이언트 번들에 들어가면 안 된다.
#
#   SEOUL_API_KEY        서울 열린데이터광장 일반 인증키
#   CACHE_TTL_SECONDS    CDN 캐시 TTL. 활용갤러리 등록 전 3600, 후 300
