# 목업 데이터로 실행할지 여부.
# 서울 열린데이터광장 인증키가 없으면 true로 둔다.
# sample 키는 지역명과 무관하게 항상 광화문·덕수궁만 돌려주므로 개발에 쓸 수 없다.
VITE_USE_MOCK=true

# HTTPS 중계 프록시 주소.
# **개발 서버에서는 비워 둔다** — vite.config.ts의 seoul-api-dev-server 플러그인이
# /api/* 를 대신 처리한다. Vercel CLI 없이 로컬에서 실데이터로 개발할 수 있고,
# api/_lib/seoul.ts의 fetchArea를 그대로 재쓰므로 로직이 두 벌이 되지 않는다.
# Vercel 배포 후에는 실제 도메인을 넣는다. 예: https://seoul-live-api.vercel.app
VITE_API_BASE_URL=

# (선택) 목업 모드에서 조회 실패를 흉내 낼 명소 이름, 쉼표로 구분.
# 예: VITE_MOCK_FAIL_AREAS=경복궁,강남역
# "정보 없음" 카드 상태를 인증키 없이 목업만으로 개발·테스트할 때 쓴다.
VITE_MOCK_FAIL_AREAS=

# Google Maps JavaScript API 키. 지도가 화면 전체의 배경이라 앱의 첫 화면부터 쓴다.
# 이 키는 클라이언트 번들에 들어간다 — 숨길 수 없는 게 정상이고 버그가 아니다.
# 지도 타일과 스크립트를 브라우저가 직접 받아야 해서 프록시 뒤로 옮길 수 없다.
# 보호는 은닉이 아니라 Google Cloud 콘솔의 제한으로 한다:
#   HTTP 리퍼러 — https://seoul-live.web.tossmini.com/*
#                 https://seoul-live.private-web.tossmini.com/*
#                 http://localhost:5173/*
#   API 제한   — Maps JavaScript API 하나만
# 비워두면 지도 자리에 "키 미설정" 안내가 뜨고 시트가 half에 묶인다. 목록·검색·
# 필터·명소 상세는 그대로 동작한다 — 지도가 없어도 앱은 선다.
VITE_GOOGLE_MAPS_API_KEY=

# 지도 스타일 ID. AdvancedMarker(혼잡도 마커)가 Map ID를 요구한다 — 없으면
# 마커가 아예 렌더되지 않는다. 개발 중에는 비워두면 DEMO_MAP_ID를 쓴다.
# 출시 전에는 Cloud Console에서 발급한 자체 Map ID로 반드시 교체한다.
VITE_GOOGLE_MAPS_MAP_ID=

# 공유 링크의 뿌리 주소. 예: https://seoul-live.vercel.app
# 명소 상세의 「공유하기」가 여기에 `?area=강남역`을 붙여 보낸다.
#
# **토스 미니앱 때문에 있는 값이다.** 토스 안에서의 `location.origin`이 남에게
# 열리는 주소인지 확인한 적이 없어서, 그걸 그대로 실으면 받은 사람이 아무 데도
# 못 가는데 보낸 쪽은 그 사실을 모른다. 배포 도메인을 여기 한 번 박아 둔다.
#
# 비워 두면 지금 열려 있는 주소를 쓴다 — 개발 서버와 Vercel 웹에서는 그게 맞다.
# 비밀이 아니라 공개 주소이므로 VITE_ 접두사가 맞다(번들에 들어가야 한다).
VITE_PUBLIC_APP_URL=

# 아래는 서버 전용이다. **VITE_ 접두사를 붙이면 안 된다.**
# Vite는 VITE_로 시작하는 것만 클라이언트 번들에 넣는데, 서울 인증키가 번들에
# 들어가면 누구나 꺼내 하루 1,000회 한도를 태울 수 있다. 로컬에서는 이 이름
# 그대로 .env에 두면 되고(vite.config.ts가 Node 쪽에서만 읽는다), 배포에서는
# Vercel 프로젝트 환경변수에 넣는다.
#
#   SEOUL_API_KEY                서울 열린데이터광장 일반 인증키
#   SEOUL_SUBWAY_API_KEY         (선택) 서울시 지하철 전용 API 키. **지금은 안 쓴다** —
#                                지하철 실시간 도착이 citydata의 SUB_STTS로 같은
#                                키에서 함께 온다(2026-08-13 실호출로 확인)
#   CACHE_TTL_SECONDS            명소 상세(citydata) CDN 캐시 TTL.
#                                활용갤러리 등록 전 3600, 후 300.
#                                **하루 1,000회 한도를 쓰는 유일한 손잡이다** —
#                                목록·지도·CCTV·인파 변화는 인증키 없는 상류라
#                                0회다. 3600이면 상세를 하루 41곳까지 열 수 있다
#                                (24 × 41 = 984). 근거는 AGENTS.md의 쿼터 조항.
#   CITYINFO_CACHE_TTL_SECONDS   비우면 위 값과 같아진다. **지금은 나눌 이유가
#                                없다** — 2026-08-27에 혼잡도와 도시정보를 한
#                                응답(citydata)으로 합쳐서 「별도 호출」이 사라졌다.
#                                남겨 둔 것은 되돌릴 여지를 위해서다.
#   CCTV_CACHE_TTL_SECONDS       명소 주변 교통 CCTV 목록 TTL. 비우면 3600.
#                                **이건 하루 1,000회 한도와 무관하다** — 상류가
#                                서울 OpenAPI가 아니라 인증키를 안 쓴다
#                                (api/_lib/seoulRtd.ts). 그래도 길게 잡는 이유는
#                                캐시가 빗나갈 때마다 남의 서버에 요청이 두 번
#                                나가기 때문이다(세션 부트스트랩 + 목록).
